generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Professionnel qui gère une ou plusieurs fiches (producteur, commerçant, prestataire).
  PRO
  ADMIN
}

/// Grande famille de lieu. Les sous-catégories sont dans src/lib/categories.ts.
enum PlaceKind {
  PRODUCTEUR
  COMMERCE
  ACTIVITE
  /// Où acheter local : marchés, dépôts de produits fermiers.
  LOCAL
}

/// Ce que le public voit d'un producteur. Les autres lieux sont toujours publics.
enum Visibility {
  /// Nom, adresse exacte et coordonnées visibles.
  PUBLIC
  /// Nom visible, position floutée (~1 km), adresse et contacts masqués.
  APPROXIMATE
  /// Nom remplacé par un pseudonyme, seule la commune est indiquée.
  ANONYMOUS
}

enum PublicationStatus {
  /// En attente de validation par un administrateur.
  PENDING
  APPROVED
  SUSPENDED
}

enum StockStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
  OUT_OF_SEASON
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PRO)
  createdAt    DateTime @default(now())
  places       Place[]
}

model Place {
  id              String            @id @default(cuid())
  /// null : fiche créée par l'administration (office de tourisme), sans compte pro.
  ownerId         String?
  owner           User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  kind            PlaceKind
  subcategory     String
  name            String
  /// Une phrase d'accroche.
  tagline         String            @default("")
  description     String            @default("")
  story           String            @default("")
  commune         String
  address         String            @default("")
  /// Position exacte. Jamais envoyée au navigateur pour un producteur non public.
  latitude        Float?
  longitude       Float?
  phone           String            @default("")
  email           String            @default("")
  website         String            @default("")
  labels          String[]          @default([])
  /// Horaires hebdomadaires : { "1": [[480, 750], [930, 1140]], … } (1 = lundi, minutes depuis minuit).
  /// Pour un marché, ce sont ses jours et heures de tenue.
  hours           Json?
  /// Mois d'ouverture ou de pratique (1-12). Vide = toute l'année.
  season          Int[]             @default([])
  /// Infos d'activité : durée, distance, dénivelé, niveau, public, tarif, point de départ, encadrant.
  facts           Json?
  visibility      Visibility        @default(PUBLIC)
  status          PublicationStatus @default(PENDING)
  /// Fermeture temporaire (congés, fin de saison…), avec un message optionnel.
  closed          Boolean           @default(false)
  closedNote      String            @default("")
  stockUpdatedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  products        Product[]
  /// Marchés et dépôts où ce producteur vend (et, en sens inverse, les producteurs d'un marché).
  sellsAt         Place[]           @relation("SellsAt")
  sellers         Place[]           @relation("SellsAt")
  organisedEvents Event[]           @relation("EventOrganiser")
  attendedEvents  Event[]           @relation("EventParticipants")
  messages        ContactMessage[]

  @@index([status, kind])
}

model Product {
  id          String      @id @default(cuid())
  placeId     String
  place       Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name        String
  description String      @default("")
  /// Ex. « le pot de 500 g », « le kg ».
  unit        String      @default("")
  /// Prix indicatif en centimes ; null = prix sur demande.
  priceCents  Int?
  stockStatus StockStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([placeId])
}

/// Événement ponctuel : fête de village, concert, foire, course… Les marchés hebdomadaires
/// sont des lieux (LOCAL) dont les occurrences sont calculées à partir des horaires.
model Event {
  id               String            @id @default(cuid())
  /// Lieu organisateur (facultatif) : l'événement est alors géré par son propriétaire.
  organiserPlaceId String?
  organiserPlace   Place?            @relation("EventOrganiser", fields: [organiserPlaceId], references: [id], onDelete: Cascade)
  subcategory      String
  title            String
  tagline          String            @default("")
  description      String            @default("")
  programme        String[]          @default([])
  commune          String
  address          String            @default("")
  latitude         Float
  longitude        Float
  startsAt         DateTime
  endsAt           DateTime
  /// Texte libre : « Gratuit », « 10 € »…
  price            String            @default("")
  organiser        String            @default("")
  status           PublicationStatus @default(APPROVED)
  participants     Place[]           @relation("EventParticipants")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, startsAt])
}

/// Message laissé par un visiteur sur une fiche, lu dans l'espace pro.
/// Permet de joindre un producteur sans exposer ses coordonnées.
model ContactMessage {
  id            String   @id @default(cuid())
  placeId       String
  place         Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  senderName    String
  senderContact String
  body          String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([placeId, createdAt])
}
