# Base PostgreSQL (Supabase, Neon, Scaleway… ou locale)
DATABASE_URL="postgresql://cartes:cartes@localhost:5432/cartes"
# Secret de signature des sessions : `openssl rand -base64 32`
SESSION_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
# Adresse publique du site, utilisée dans les liens des e-mails
APP_URL="http://localhost:3000"
# E-mails (https://resend.com). Sans ces variables, les e-mails sont affichés dans les logs du serveur.
RESEND_API_KEY=""
MAIL_FROM="Producteurs de la vallée d'Ax <commandes@votre-domaine.fr>"
# Temps de trajet réels (https://openrouteservice.org, clé gratuite). Sans clé : estimation à vol d'oiseau.
ORS_API_KEY=""
